[Unit]
Description=Naming Tool INPI API (gunicorn)
After=network.target

[Service]
Type=simple
User=olive
Group=olive
WorkingDirectory=/home/olive/naming-tool
Environment="PATH=/home/olive/naming-tool/venv/bin"
EnvironmentFile=/home/olive/naming-tool/.env
ExecStart=/home/olive/naming-tool/venv/bin/gunicorn -w 2 -b 127.0.0.1:8099 server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
